/* 
    Intelleo Main Stylesheet (QSS)
    Centralized styles for the PySide6 Application
*/

/* Global Colors & Fonts */
QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
    color: #1F2937;
}

/* Main Window & View Containers */
QMainWindow, .ViewContainer {
    background-color: #F3F4F6;
}

/* Login View specific */
#LoginContainer {
    background-color: white;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
}

#LoginTitle {
    font-size: 24pt;
    font-weight: bold;
    color: #1E3A8A;
}

#LoginSubtitle {
    font-size: 10pt;
    font-style: italic;
    color: #6B7280;
}

/* Buttons */
QPushButton {
    padding: 8px 15px;
    border-radius: 4px;
    font-weight: bold;
    border: 1px solid #D1D5DB;
    background-color: white;
}

QPushButton:hover {
    background-color: #F9FAFB;
}

QPushButton:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

.PrimaryButton {
    background-color: #1D4ED8;
    color: white;
    border: none;
}

.PrimaryButton:hover {
    background-color: #1E40AF;
}

.SuccessButton {
    background-color: #10B981;
    color: white;
    border: none;
}

.SuccessButton:hover {
    background-color: #059669;
}

.DangerButton {
    background-color: #DC2626;
    color: white;
    border: none;
}

.DangerButton:hover {
    background-color: #B91C1C;
}

/* Specific for Lyra Sidebar */
.QuickPromptButton {
    text-align: left;
    padding: 10px;
    border: none;
    color: white;
}

/* Inputs */
QLineEdit, QTextEdit, QComboBox, QTextBrowser {
    padding: 8px;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    background-color: white;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #3B82F6;
}

/* Log Area */
#LogArea {
    background-color: #1E1E1E;
    color: #D4D4D4;
    border-radius: 4px;
    font-family: "Consolas", "Monaco", monospace;
}

/* Tables */
QTableWidget {
    background-color: white;
    border: 1px solid #D1D5DB;
    gridline-color: #E5E7EB;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
    alternate-background-color: #F9FAFB;
}

QHeaderView::section {
    background-color: #F3F4F6;
    padding: 5px;
    border: 1px solid #D1D5DB;
    font-weight: bold;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #D1D5DB;
    top: -1px;
    background: white;
}

QTabBar::tab {
    background: #E5E7EB;
    border: 1px solid #D1D5DB;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: white;
    border-bottom-color: white;
}

/* Toolbar Containers */
.Toolbar {
    background-color: transparent;
}

#HeaderFrame {
    background-color: #1E3A8A;
}

#HeaderTitle {
    font-size: 18pt;
    font-weight: bold;
    color: white;
}

#StatusBanner {
    background-color: #FEF3C7;
    border-bottom: 1px solid #FCD34D;
}

#StatusLabel {
    color: #92400E;
    font-weight: bold;
}

/* Custom Labels and Frames */
.SectionHeader {
    font-size: 14pt;
    font-weight: bold;
    color: #111827;
}

.LegendLabel {
    color: #6B7280;
    font-size: 9pt;
}

.SidebarFrame {
    background-color: white;
    border-radius: 8px;
}

.ChatInputFrame {
    background-color: white;
    border-radius: 8px;
    border: 1px solid #D1D5DB;
}
